\zref@newlabel{fig:EBC-OPEN}{\default{5.5a}\page{86}\title{Extrapolation boundary conditions}\abspage{94}\zc@counter{subfigure}\thecounter{a}\zc@type{figure}\zc@cntval{1}\zc@pgval{86}\zc@enclval{{5}{5}{0}}\zc@pgfmt{2}\anchor{figure.caption.91}\subref{a}}
\newlabel{fig:EBC-OPEN}{{5.5a}{86}{Open boundary. A ghost particle $g$ is matched to the fluid particle $q$ nearest a target three columns inside the domain, then each field of ghost $g$ is set by a first-order Taylor extrapolation from $q$}{figure.caption.91}{}}
\zref@newlabel{sub@fig:EBC-OPEN}{\default{a}\page{86}\title{Extrapolation boundary conditions}\abspage{94}\zc@counter{subfigure}\thecounter{a}\zc@type{figure}\zc@cntval{1}\zc@pgval{86}\zc@enclval{{5}{5}{0}}\zc@pgfmt{2}\anchor{figure.caption.91}\subref{a}}
\newlabel{sub@fig:EBC-OPEN}{{a}{86}{Open boundary. A ghost particle $g$ is matched to the fluid particle $q$ nearest a target three columns inside the domain, then each field of ghost $g$ is set by a first-order Taylor extrapolation from $q$}{figure.caption.91}{}}
\zref@newlabel{fig:EBC-MOUNTAIN}{\default{5.5b}\page{86}\title{Extrapolation boundary conditions}\abspage{94}\zc@counter{subfigure}\thecounter{b}\zc@type{figure}\zc@cntval{2}\zc@pgval{86}\zc@enclval{{5}{5}{0}}\zc@pgfmt{2}\anchor{figure.caption.91}\subref{b}}
\newlabel{fig:EBC-MOUNTAIN}{{5.5b}{86}{Solid mountain boundary. The wall particle $p$ is assigned the extrapolated velocity $\vb v_e$ of the nearest fluid $q$; reflecting its normal component about the surface yields the free-slip velocity $\vb v$}{figure.caption.91}{}}
\zref@newlabel{sub@fig:EBC-MOUNTAIN}{\default{b}\page{86}\title{Extrapolation boundary conditions}\abspage{94}\zc@counter{subfigure}\thecounter{b}\zc@type{figure}\zc@cntval{2}\zc@pgval{86}\zc@enclval{{5}{5}{0}}\zc@pgfmt{2}\anchor{figure.caption.91}\subref{b}}
\newlabel{sub@fig:EBC-MOUNTAIN}{{b}{86}{Solid mountain boundary. The wall particle $p$ is assigned the extrapolated velocity $\vb v_e$ of the nearest fluid $q$; reflecting its normal component about the surface yields the free-slip velocity $\vb v$}{figure.caption.91}{}}
