\@writefile{lof}{\contentsline {figure}{\numberline {6.7}{\ignorespaces The emerging mountain wave captured using the well-balanced pressure-potential temperature formulation. The panels illustrate \emph  {upward propagations} of the wave, visualized via the vertical velocity $w$ and lines of constant potential temperature. However, as seen in the final panel \subref  {fig:pth-wave-60} the simulation is ruined due the onset of \emph  {tensile instability}.}}{93}{figure.caption.100}\protected@file@percent }
\zref@newlabel{fig:WAVE-EMERGENCE-PTH}{\default{6.7}\page{93}\title{The emerging mountain wave captured using the well-balanced pressure-potential temperature formulation. The panels illustrate \emph {upward propagations} of the wave, visualized via the vertical velocity $w$ and lines of constant potential temperature. However, as seen in the final panel \subref {fig:pth-wave-60} the simulation is ruined due the onset of \emph {tensile instability}}\abspage{101}\zc@counter{figure}\thecounter{6.7}\zc@type{figure}\zc@cntval{7}\zc@pgval{93}\zc@enclval{{6}{0}}\zc@pgfmt{2}\anchor{figure.caption.100}}
\newlabel{fig:WAVE-EMERGENCE-PTH}{{6.7}{93}{The emerging mountain wave captured using the well-balanced pressure-potential temperature formulation. The panels illustrate \emph {upward propagations} of the wave, visualized via the vertical velocity $w$ and lines of constant potential temperature. However, as seen in the final panel \subref {fig:pth-wave-60} the simulation is ruined due the onset of \emph {tensile instability}}{figure.caption.100}{}}
